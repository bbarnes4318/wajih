# ---------------------------------------------------------------------------
#  DATABASE
# ---------------------------------------------------------------------------
# PostgreSQL 14+. The schema uses native enums, text[] arrays and JSONB.
DATABASE_URL="postgresql://user:password@host:5432/leados?schema=public"

# ---------------------------------------------------------------------------
#  SESSION / SIGNING
# ---------------------------------------------------------------------------
# Signs delivery webhook bodies (x-leados-signature header). Rotate per env.
WEBHOOK_SIGNING_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
#  COMPLIANCE PROVIDERS
# ---------------------------------------------------------------------------
# mock  -> local suppression_entries table (default, no credentials needed)
# http  -> live vendor endpoint
DNC_PROVIDER="mock"
DNC_ENDPOINT=""
DNC_API_KEY=""

# mock  -> offline certificate shape + freshness inspection (default)
# http  -> TrustedForm certificate lookup
CONSENT_PROVIDER="mock"
TRUSTEDFORM_API_KEY=""

# ---------------------------------------------------------------------------
#  SCHEDULED JOBS
# ---------------------------------------------------------------------------
# Bearer token required by /api/cron/* endpoints.
CRON_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
#  OBJECT STORAGE (S3-compatible)
# ---------------------------------------------------------------------------
# Publisher agreements, landing-page snapshots and raw CSV batches.
# Leave S3_BUCKET empty to fall back to local disk under .storage/.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
